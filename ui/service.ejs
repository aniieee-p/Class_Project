<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    body { background: #09090b; font-family: 'Inter', sans-serif; }
    .mono { font-family: 'JetBrains Mono', monospace; }
    .grid-bg {
      background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
      background-size: 40px 40px;
    }
    .scard { transition: transform 0.2s ease, border-color 0.2s, box-shadow 0.2s; }
    .scard:hover { transform: translateY(-3px); }
    .card-violet:hover  { border-color: #a78bfa; box-shadow: 0 0 28px rgba(167,139,250,0.15); }
    .card-amber:hover   { border-color: #f59e0b; box-shadow: 0 0 28px rgba(245,158,11,0.15); }
    .card-pink:hover    { border-color: #f472b6; box-shadow: 0 0 28px rgba(244,114,182,0.15); }
    .card-sky:hover     { border-color: #38bdf8; box-shadow: 0 0 28px rgba(56,189,248,0.15); }
    .card-emerald:hover { border-color: #34d399; box-shadow: 0 0 28px rgba(52,211,153,0.15); }
    .card-orange:hover  { border-color: #fb923c; box-shadow: 0 0 28px rgba(251,146,60,0.15); }
    .badge { font-family: 'JetBrains Mono', monospace; font-size: 10px; padding: 2px 8px; border-radius: 3px; }
    .badge-violet  { background: rgba(167,139,250,0.1); color: #a78bfa; border: 1px solid rgba(167,139,250,0.2); }
    .badge-amber   { background: rgba(245,158,11,0.1);  color: #f59e0b; border: 1px solid rgba(245,158,11,0.2); }
    .badge-pink    { background: rgba(244,114,182,0.1); color: #f472b6; border: 1px solid rgba(244,114,182,0.2); }
    .badge-sky     { background: rgba(56,189,248,0.1);  color: #38bdf8; border: 1px solid rgba(56,189,248,0.2); }
    .badge-emerald { background: rgba(52,211,153,0.1);  color: #34d399; border: 1px solid rgba(52,211,153,0.2); }
    .badge-orange  { background: rgba(251,146,60,0.1);  color: #fb923c; border: 1px solid rgba(251,146,60,0.2); }
    .prog-bar  { height: 2px; border-radius: 1px; background: #27272a; overflow: hidden; }
    .prog-fill { height: 100%; border-radius: 1px; }
  </style>
</head>
<body class="text-zinc-100 min-h-screen">
  <%- include("header") %>

  <section class="grid-bg py-24 px-6 md:px-16 border-b border-zinc-800">
    <div class="max-w-7xl mx-auto">
      <p class="mono text-xs text-zinc-500 mb-4">// services.list</p>
      <h1 class="mono text-5xl md:text-6xl font-bold text-white mb-6 leading-tight">What we<br/>teach.</h1>
      <p class="text-zinc-400 text-lg max-w-xl">Hands-on tracks built around real engineering skills. Pick a path and start building.</p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-6 md:px-16 py-20 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">

    <!-- Web Dev -->
    <div class="scard card-violet bg-zinc-900 border border-zinc-800 rounded-xl p-7 flex flex-col gap-4 group cursor-pointer"
         style="background: linear-gradient(145deg, #18181b, #1e1427);">
      <div class="flex items-center justify-between">
        <span class="badge badge-violet">full-stack</span>
        <span class="mono text-xs text-zinc-700">01</span>
      </div>
      <div class="text-3xl">🌐</div>
      <div class="flex-1">
        <h3 class="mono text-xl font-bold text-white mb-2 group-hover:text-violet-300 transition">Web Development</h3>
        <p class="text-zinc-400 text-sm leading-relaxed">Full-stack from HTML/CSS to Node.js, Express, and MongoDB. Build and deploy real apps.</p>
      </div>
      <div>
        <div class="prog-bar mb-3"><div class="prog-fill bg-violet-400" style="width:80%"></div></div>
        <div class="flex items-center justify-between">
          <span class="mono text-xs text-zinc-600">16 modules · 8h</span>
          <span class="mono text-xs text-violet-400 group-hover:translate-x-1 transition-all">→</span>
        </div>
      </div>
    </div>

    <!-- Mobile -->
    <div class="scard card-pink bg-zinc-900 border border-zinc-800 rounded-xl p-7 flex flex-col gap-4 group cursor-pointer"
         style="background: linear-gradient(145deg, #18181b, #1c0f18);">
      <div class="flex items-center justify-between">
        <span class="badge badge-pink">cross-platform</span>
        <span class="mono text-xs text-zinc-700">02</span>
      </div>
      <div class="text-3xl">📱</div>
      <div class="flex-1">
        <h3 class="mono text-xl font-bold text-white mb-2 group-hover:text-pink-300 transition">Android & iOS</h3>
        <p class="text-zinc-400 text-sm leading-relaxed">Cross-platform mobile apps with React Native. One codebase, two platforms.</p>
      </div>
      <div>
        <div class="prog-bar mb-3"><div class="prog-fill bg-pink-400" style="width:60%"></div></div>
        <div class="flex items-center justify-between">
          <span class="mono text-xs text-zinc-600">12 modules · 6h</span>
          <span class="mono text-xs text-pink-400 group-hover:translate-x-1 transition-all">→</span>
        </div>
      </div>
    </div>

    <!-- DSA -->
    <div class="scard card-amber bg-zinc-900 border border-zinc-800 rounded-xl p-7 flex flex-col gap-4 group cursor-pointer"
         style="background: linear-gradient(145deg, #18181b, #1c1608);">
      <div class="flex items-center justify-between">
        <span class="badge badge-amber">interview-prep</span>
        <span class="mono text-xs text-zinc-700">03</span>
      </div>
      <div class="text-3xl">🧠</div>
      <div class="flex-1">
        <h3 class="mono text-xl font-bold text-white mb-2 group-hover:text-amber-300 transition">DSA & Interviews</h3>
        <p class="text-zinc-400 text-sm leading-relaxed">200+ problems covering arrays, trees, graphs, DP. Crack FAANG-level interviews.</p>
      </div>
      <div>
        <div class="prog-bar mb-3"><div class="prog-fill bg-amber-400" style="width:70%"></div></div>
        <div class="flex items-center justify-between">
          <span class="mono text-xs text-zinc-600">20 modules · 10h</span>
          <span class="mono text-xs text-amber-400 group-hover:translate-x-1 transition-all">→</span>
        </div>
      </div>
    </div>

    <!-- Cloud -->
    <div class="scard card-sky bg-zinc-900 border border-zinc-800 rounded-xl p-7 flex flex-col gap-4 group cursor-pointer"
         style="background: linear-gradient(145deg, #18181b, #0c1a24);">
      <div class="flex items-center justify-between">
        <span class="badge badge-sky">devops</span>
        <span class="mono text-xs text-zinc-700">04</span>
      </div>
      <div class="text-3xl">☁️</div>
      <div class="flex-1">
        <h3 class="mono text-xl font-bold text-white mb-2 group-hover:text-sky-300 transition">Cloud & DevOps</h3>
        <p class="text-zinc-400 text-sm leading-relaxed">Docker, CI/CD, cloud deployment. The tools real engineering teams use daily.</p>
      </div>
      <div>
        <div class="prog-bar mb-3"><div class="prog-fill bg-sky-400" style="width:45%"></div></div>
        <div class="flex items-center justify-between">
          <span class="mono text-xs text-zinc-600">10 modules · 5h</span>
          <span class="mono text-xs text-sky-400 group-hover:translate-x-1 transition-all">→</span>
        </div>
      </div>
    </div>

    <!-- UI/UX -->
    <div class="scard card-emerald bg-zinc-900 border border-zinc-800 rounded-xl p-7 flex flex-col gap-4 group cursor-pointer"
         style="background: linear-gradient(145deg, #18181b, #0a1f18);">
      <div class="flex items-center justify-between">
        <span class="badge badge-emerald">design</span>
        <span class="mono text-xs text-zinc-700">05</span>
      </div>
      <div class="text-3xl">🎨</div>
      <div class="flex-1">
        <h3 class="mono text-xl font-bold text-white mb-2 group-hover:text-emerald-300 transition">UI/UX & Design</h3>
        <p class="text-zinc-400 text-sm leading-relaxed">Figma, Tailwind, design systems. Build interfaces that feel as good as they look.</p>
      </div>
      <div>
        <div class="prog-bar mb-3"><div class="prog-fill bg-emerald-400" style="width:55%"></div></div>
        <div class="flex items-center justify-between">
          <span class="mono text-xs text-zinc-600">8 modules · 4h</span>
          <span class="mono text-xs text-emerald-400 group-hover:translate-x-1 transition-all">→</span>
        </div>
      </div>
    </div>

    <!-- AI/ML -->
    <div class="scard card-orange bg-zinc-900 border border-zinc-800 rounded-xl p-7 flex flex-col gap-4 group cursor-pointer"
         style="background: linear-gradient(145deg, #18181b, #1c1008);">
      <div class="flex items-center justify-between">
        <span class="badge badge-orange">emerging</span>
        <span class="mono text-xs text-zinc-700">06</span>
      </div>
      <div class="text-3xl">🤖</div>
      <div class="flex-1">
        <h3 class="mono text-xl font-bold text-white mb-2 group-hover:text-orange-300 transition">AI & ML</h3>
        <p class="text-zinc-400 text-sm leading-relaxed">Python, ML fundamentals, and building AI-powered apps. No prior experience needed.</p>
      </div>
      <div>
        <div class="prog-bar mb-3"><div class="prog-fill bg-orange-400" style="width:35%"></div></div>
        <div class="flex items-center justify-between">
          <span class="mono text-xs text-zinc-600">14 modules · 7h</span>
          <span class="mono text-xs text-orange-400 group-hover:translate-x-1 transition-all">→</span>
        </div>
      </div>
    </div>

  </section>

  <!-- CTA -->
  <section class="max-w-7xl mx-auto px-6 md:px-16 pb-24">
    <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-10 flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <p class="mono text-xs text-zinc-500 mb-2">// ready to start?</p>
        <h2 class="mono text-2xl font-bold text-white">Pick a track. Start building.</h2>
      </div>
      <a href="/register" class="mono text-sm px-6 py-2.5 rounded-md bg-gradient-to-r from-violet-500 to-sky-500 text-white hover:from-violet-400 hover:to-sky-400 transition font-semibold shrink-0">get_started()</a>
    </div>
  </section>

</body>
</html>
