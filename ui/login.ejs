<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    * { box-sizing: border-box; }
    body { font-family: 'JetBrains Mono', monospace; background: #09090b; }

    /* Dotted grid */
    .dot-grid {
      background-image: radial-gradient(circle, #27272a 1px, transparent 1px);
      background-size: 28px 28px;
    }

    /* Laser scan line */
    @keyframes scan {
      0% { top: -10%; opacity: 0.6; }
      100% { top: 110%; opacity: 0; }
    }
    .scan-line {
      position: fixed;
      left: 0; right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(34,211,238,0.4), transparent);
      animation: scan 4s linear infinite;
      pointer-events: none;
      z-index: 0;
    }

    /* Cyan focus border */
    .code-input {
      background: #09090b;
      border: 1px solid #27272a;
      color: #e4e4e7;
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
      transition: border-color 0.15s, box-shadow 0.15s;
      outline: none;
    }
    .code-input:focus {
      border-color: #22d3ee;
      box-shadow: -3px 0 0 0 #22d3ee;
    }

    @keyframes fadeUp { from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:translateY(0)} }
    .fade-up { animation: fadeUp 0.4s ease forwards; }
    .auth-card { transition: transform 0.2s ease, border-color 0.2s, box-shadow 0.2s; }
    .auth-card:hover { transform: translateY(-3px); border-color: #a78bfa; box-shadow: 0 0 40px rgba(167,139,250,0.12); }
  </style>
</head>
<body class="dot-grid min-h-screen flex items-center justify-center px-4">

  <div class="scan-line"></div>

  <div class="fade-up relative z-10 w-full max-w-sm">

    <!-- Card -->
    <div class="auth-card bg-zinc-900/60 border border-zinc-800 rounded-md p-8 backdrop-blur-sm">

      <!-- Brand -->
      <div class="mb-8">
        <p class="text-xs text-zinc-600 mb-1">// auth.module</p>
        <h1 class="text-white text-lg font-bold tracking-tight">CodeLearn <span class="text-cyan-400">//</span> Auth</h1>
        <p class="text-zinc-600 text-xs mt-1">sign_in to continue</p>
      </div>

      <!-- Error -->
      <% if (locals.error) { %>
      <div class="mb-5 px-3 py-2 rounded-sm border border-red-500/30 bg-red-500/5 text-red-400 text-xs flex items-center gap-2">
        <span class="text-red-500">✗</span> <%= error %>
      </div>
      <% } %>

      <!-- Success -->
      <% if (locals.success) { %>
      <div class="mb-5 px-3 py-2 rounded-sm border border-green-500/30 bg-green-500/5 text-green-400 text-xs flex items-center gap-2">
        <span class="text-green-500">✓</span> <%= success %>
      </div>
      <% } %>

      <!-- Form -->
      <form action="/login" method="POST" class="flex flex-col gap-4">

        <div>
          <label class="text-zinc-500 text-xs block mb-1.5">[ email ]</label>
          <input type="email" name="email" placeholder="user@domain.com" required
            class="code-input w-full px-3 py-2.5 rounded-sm" />
        </div>

        <div>
          <div class="flex justify-between mb-1.5">
            <label class="text-zinc-500 text-xs">* password</label>
            <a href="#" class="text-xs text-zinc-600 hover:text-cyan-400 transition">forgot?</a>
          </div>
          <div class="relative">
            <input type="password" name="password" id="pwd" placeholder="••••••••••••" required
              class="code-input w-full px-3 py-2.5 rounded-sm pr-10" />
            <button type="button" onclick="togglePwd()" class="absolute right-3 top-1/2 -translate-y-1/2 text-zinc-600 hover:text-zinc-300 transition text-xs">
              show
            </button>
          </div>
        </div>

        <div class="flex items-center gap-2 mt-1">
          <input type="checkbox" id="remember" class="w-3.5 h-3.5 accent-cyan-400" />
          <label for="remember" class="text-zinc-600 text-xs">remember_session</label>
        </div>

        <button type="submit" id="loginBtn"
          class="mt-2 w-full py-2.5 rounded-sm bg-white text-zinc-950 text-sm font-bold hover:bg-zinc-200 transition tracking-tight flex items-center justify-center gap-2">
          <svg id="loginSpinner" class="hidden w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/>
          </svg>
          <span id="loginBtnText">sign_in()</span>
        </button>

      </form>

      <!-- Divider -->
      <div class="flex items-center gap-3 my-5">
        <div class="flex-1 h-px bg-zinc-800"></div>
        <span class="text-zinc-700 text-xs">or</span>
        <div class="flex-1 h-px bg-zinc-800"></div>
      </div>

      <!-- GitHub -->
      <button type="button"
        class="w-full py-2.5 rounded-sm border border-zinc-700 text-zinc-300 text-xs font-medium hover:border-zinc-500 hover:text-white transition flex items-center justify-center gap-2">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        continue_with_github
      </button>

      <p class="text-center text-zinc-700 text-xs mt-6">
        no account? <a href="/register" class="text-cyan-400 hover:text-cyan-300 transition">register()</a>
      </p>

    </div>

    <!-- Footer hint -->
    <p class="text-center text-zinc-800 text-xs mt-4 font-mono">codelearn.dev ~ v1.0.0</p>
  </div>

  <script>
    function togglePwd() {
      const p = document.getElementById('pwd');
      const btn = p.nextElementSibling;
      p.type = p.type === 'password' ? 'text' : 'password';
      btn.textContent = p.type === 'password' ? 'show' : 'hide';
    }
    document.querySelector('form').addEventListener('submit', function() {
      document.getElementById('loginSpinner').classList.remove('hidden');
      document.getElementById('loginBtnText').textContent = 'signing_in...';
      document.getElementById('loginBtn').disabled = true;
    });
  </script>
</body>
</html>
