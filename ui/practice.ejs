<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    body { background: #09090b; font-family: 'Inter', sans-serif; }
    .mono { font-family: 'JetBrains Mono', monospace; }
    textarea { font-family: 'JetBrains Mono', monospace; tab-size: 2; }
    textarea:focus { outline: none; }
  </style>
</head>
<body class="text-zinc-100 min-h-screen">
  <%- include("header") %>

  <section class="max-w-7xl mx-auto px-6 md:px-16 py-12">
    <div class="mb-8">
      <p class="mono text-xs text-zinc-500 mb-2">// playground.html</p>
      <h1 class="mono text-3xl font-bold text-white">Code Editor</h1>
      <p class="text-zinc-500 text-sm mt-1">Write HTML/CSS/JS — preview updates live.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-3">

      <!-- Editor pane -->
      <div class="bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2.5 border-b border-zinc-800">
          <div class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-red-500/70"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/70"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-green-500/70"></span>
          </div>
          <span class="mono text-xs text-zinc-600">editor.html</span>
          <button onclick="clearEditor()" class="mono text-xs text-zinc-600 hover:text-zinc-300 transition">clear</button>
        </div>
        <textarea id="code" placeholder="// write your code here..."
          class="w-full h-64 md:h-[500px] bg-zinc-900 text-green-400 text-sm p-5 resize-none leading-relaxed"></textarea>
      </div>

      <!-- Preview pane -->
      <div class="bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2.5 border-b border-zinc-800">
          <div class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-red-500/70"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/70"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-green-500/70"></span>
          </div>
          <span class="mono text-xs text-zinc-600">preview</span>
          <span class="mono text-xs text-green-500">● live</span>
        </div>
        <iframe id="preview" class="w-full h-64 md:h-[500px] bg-white"></iframe>
      </div>

    </div>

    <!-- Snippets -->
    <div class="mt-5 flex flex-wrap items-center gap-2">
      <span class="mono text-xs text-zinc-600 mr-2">snippets:</span>
      <button onclick="loadSnippet('html')" class="mono text-xs px-3 py-1.5 rounded border border-zinc-800 text-zinc-500 hover:border-zinc-600 hover:text-zinc-300 transition">html_boilerplate</button>
      <button onclick="loadSnippet('flex')" class="mono text-xs px-3 py-1.5 rounded border border-zinc-800 text-zinc-500 hover:border-zinc-600 hover:text-zinc-300 transition">flexbox_layout</button>
      <button onclick="loadSnippet('btn')" class="mono text-xs px-3 py-1.5 rounded border border-zinc-800 text-zinc-500 hover:border-zinc-600 hover:text-zinc-300 transition">styled_button</button>
    </div>
  </section>

  <script>
    const code = document.getElementById("code");
    const preview = document.getElementById("preview");
    code.addEventListener("keyup", () => { preview.srcdoc = code.value; });
    function clearEditor() { code.value = ""; preview.srcdoc = ""; }
    const snippets = {
      html: `<!DOCTYPE html>\n<html lang="en">\n<head>\n  <meta charset="UTF-8">\n  <title>Page</title>\n</head>\n<body>\n  <h1>Hello World</h1>\n  <%- include("footer") %>
</body>\n</html>`,
      flex: `<style>\n  body { margin: 0; }\n  .container { display: flex; justify-content: center; align-items: center; gap: 16px; height: 100vh; background: #09090b; }\n  .box { width: 80px; height: 80px; background: #6366f1; border-radius: 8px; }\n</style>\n<div class="container">\n  <div class="box"></div>\n  <div class="box"></div>\n  <div class="box"></div>\n</div>`,
      btn: `<style>\n  body { display:flex; justify-content:center; align-items:center; height:100vh; background:#09090b; }\n  button { padding: 10px 24px; background: white; color: #09090b; border: none; border-radius: 6px; font-family: monospace; font-size: 14px; cursor: pointer; }\n  button:hover { background: #d4d4d8; }\n</style>\n<button>get_started()</button>`
    };
    function loadSnippet(k) { code.value = snippets[k]; preview.srcdoc = snippets[k]; }
  </script>
  <%- include("footer") %>
</body>
</html>

