<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    body { background: #09090b; font-family: 'Inter', sans-serif; }
    .mono { font-family: 'JetBrains Mono', monospace; }
    .course-row { transition: border-color 0.15s; }
    .course-row:hover { border-color: #3f3f46; }
  </style>
</head>
<body class="text-zinc-100 min-h-screen">
  <%- include("header") %>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 md:px-16 py-12 md:py-20">
    <div class="mb-8 md:mb-10">
      <p class="mono text-xs text-zinc-500 mb-2">// courses.manage</p>
      <h1 class="mono text-2xl sm:text-3xl md:text-4xl font-bold text-white">Courses</h1>
    </div>

    <form id="courseForm" action="/courses/add" method="POST" class="flex flex-col sm:flex-row gap-2 mb-10 md:mb-12">
      <input type="text" name="course" id="courseInput" placeholder="course_name..." required
        class="flex-1 mono text-sm px-4 py-2.5 rounded-lg bg-zinc-900 border border-zinc-800 text-white placeholder-zinc-600 focus:outline-none focus:border-zinc-600 transition" />
      <button type="submit" id="submitBtn"
        class="mono text-sm px-5 py-2.5 rounded-lg bg-white text-zinc-950 hover:bg-zinc-200 transition font-semibold sm:shrink-0">
        add()
      </button>
    </form>

    <% if (courses.length === 0) { %>
      <div class="text-center py-16 md:py-20">
        <p class="mono text-zinc-600 text-sm">// no courses found</p>
        <p class="mono text-zinc-700 text-xs mt-2">add your first course above</p>
      </div>
    <% } else { %>
    <div class="flex flex-col gap-2">
      <% courses.forEach(function(c, i){ %>
      <div class="course-row flex items-center justify-between bg-zinc-900 border border-zinc-800 rounded-lg px-4 sm:px-5 py-3 sm:py-4 gap-3">
        <div class="flex items-center gap-3 sm:gap-4 min-w-0">
          <span class="mono text-xs text-zinc-700 shrink-0"><%= String(i+1).padStart(2,'0') %></span>
          <span class="text-white text-sm font-medium truncate"><%= c.course %></span>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <button onclick="editCourse('<%= c._id || c.id %>','<%= c.course %>')"
            class="mono text-xs px-2.5 sm:px-3 py-1.5 rounded border border-zinc-700 text-zinc-400 hover:border-zinc-500 hover:text-white transition">
            edit
          </button>
          <a href="/courses/delete/<%= c._id || c.id %>"
            class="mono text-xs px-2.5 sm:px-3 py-1.5 rounded border border-zinc-800 text-zinc-600 hover:border-red-500/40 hover:text-red-400 transition">
            delete
          </a>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>
  </section>

  <script>
    function editCourse(id, course) {
      document.getElementById("courseInput").value = course;
      document.getElementById("submitBtn").textContent = "update()";
      document.getElementById("courseForm").action = "/courses/update/" + id;
      document.getElementById("courseInput").focus();
    }
  </script>
  <%- include("footer") %>
</body>
</html>
